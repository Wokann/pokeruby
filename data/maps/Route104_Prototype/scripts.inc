Route104_Prototype_MapScripts:: @ 8160C4A
	.byte 0

Route104_Prototype_EventScript_StaffMember1:: @ 8160C4B
	lock
	faceplayer
	goto_if_not_defeated TRAINER_BRIANNA_1, Route104_Prototype_EventScript_StaffMember1TrainersNotDefeated
	goto_if_not_defeated TRAINER_CINDY_2, Route104_Prototype_EventScript_StaffMember1TrainersNotDefeated
	goto_if_not_defeated TRAINER_AMY_AND_LIV_3, Route104_Prototype_EventScript_StaffMember1TrainersNotDefeated
	goto_if_not_defeated TRAINER_GINA_AND_MIA_2, Route104_Prototype_EventScript_StaffMember1TrainersNotDefeated
	goto_if_not_defeated TRAINER_LUCAS_2, Route104_Prototype_EventScript_StaffMember1TrainersNotDefeated
	goto_if_not_defeated TRAINER_MIKE_1, Route104_Prototype_EventScript_StaffMember1TrainersNotDefeated
	setflag FLAG_ROUTE_104_PROTOTYPE_COMPLETED_1
	msgbox Route104_Prototype_Text_StaffMember1ThanksForComing, MSGBOX_DEFAULT
	goto_if_set FLAG_ROUTE_104_PROTOTYPE_COMPLETED_2, Route104_Prototype_EventScript_SoftReset
	release
	end

Route104_Prototype_EventScript_StaffMember1TrainersNotDefeated:: @ 8160C99
	msgbox Route104_Prototype_Text_StaffMember1AskDefeatAllTrainers, MSGBOX_DEFAULT
	release
	end

