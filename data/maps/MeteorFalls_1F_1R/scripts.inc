MeteorFalls_1F_1R_EventScript_EvilTeamStealsMeteoriteScene:: @ 815C49C
	lockall
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	delay 30
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_1, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	msgbox MeteorFalls_1F_1R_Text_WithThisMeteorite, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_1, Common_Movement_WalkInPlaceFasterUp
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_2, Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	playse SE_PIN
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_1, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_1, Common_Movement_Delay48
	waitmovement 0
	msgbox MeteorFalls_1F_1R_Text_DontExpectMercyFromEvilTeam, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_1, MeteorFalls_1F_1R_Movement_EvilGruntApproachPlayer
	waitmovement 0
	msgbox MeteorFalls_1F_1R_Text_HoldItRightThereEvilTeam, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_1, Common_Movement_WalkInPlaceFasterLeft
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_2, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	addobject LOCALID_METEOR_FALLS_GOOD_LEADER
	addobject LOCALID_METEOR_FALLS_GOOD_GRUNT_1
	addobject LOCALID_METEOR_FALLS_GOOD_GRUNT_2
	applymovement LOCALID_METEOR_FALLS_GOOD_LEADER, MeteorFalls_1F_1R_Movement_GoodLeaderArrive
	applymovement LOCALID_METEOR_FALLS_GOOD_GRUNT_1, MeteorFalls_1F_1R_Movement_GoodGrunt1Arrive
	applymovement LOCALID_METEOR_FALLS_GOOD_GRUNT_2, MeteorFalls_1F_1R_Movement_GoodGrunt2Arrive
	waitmovement 0
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_1, Common_Movement_WalkInPlaceFasterLeft
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_2, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	msgbox MeteorFalls_1F_1R_Text_BeSeeingYouGoodTeam, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_PLAYER, MeteorFalls_1F_1R_Movement_PushPlayerOutOfWay
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_1, MeteorFalls_1F_1R_Movement_EvilGrunt1Exit
	applymovement LOCALID_METEOR_FALLS_EVIL_GRUNT_2, MeteorFalls_1F_1R_Movement_EvilGrunt2Exit
	waitmovement 0
	removeobject LOCALID_METEOR_FALLS_EVIL_GRUNT_1
	removeobject LOCALID_METEOR_FALLS_EVIL_GRUNT_2
	applymovement LOCALID_METEOR_FALLS_GOOD_LEADER, MeteorFalls_1F_1R_Movement_GoodLeaderApproachPlayer
	waitmovement 0
	.ifdef SAPPHIRE
	msgbox MeteorFalls_1F_1R_Text_MaxieSeenYouBefore, MSGBOX_DEFAULT
	.else
	msgbox MeteorFalls_1F_1R_Text_ArchieSeenYouBefore, MSGBOX_DEFAULT
	.endif
	closemessage
	applymovement LOCALID_METEOR_FALLS_GOOD_GRUNT_1, MeteorFalls_1F_1R_Movement_GoodGrunt1ApproachLeader
	applymovement LOCALID_METEOR_FALLS_GOOD_GRUNT_2, MeteorFalls_1F_1R_Movement_GoodGrunt2ApproachLeader
	waitmovement 0
	msgbox MeteorFalls_1F_1R_Text_BossWeShouldChaseEvilTeam, MSGBOX_DEFAULT
	applymovement LOCALID_METEOR_FALLS_GOOD_LEADER, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	msgbox MeteorFalls_1F_1R_Text_GoodLeaderNoTellingWhatEvilTeamWillDo, MSGBOX_DEFAULT
	applymovement LOCALID_METEOR_FALLS_GOOD_LEADER, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	msgbox MeteorFalls_1F_1R_Text_GoodLeaderFarewell, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_METEOR_FALLS_GOOD_LEADER, MeteorFalls_1F_1R_Movement_GoodLeaderExit
	applymovement LOCALID_METEOR_FALLS_GOOD_GRUNT_1, MeteorFalls_1F_1R_Movement_GoodGrunt1Exit
	applymovement LOCALID_METEOR_FALLS_GOOD_GRUNT_2, MeteorFalls_1F_1R_Movement_GoodGrunt2Exit
	waitmovement 0
	removeobject LOCALID_METEOR_FALLS_GOOD_LEADER
	removeobject LOCALID_METEOR_FALLS_GOOD_GRUNT_1
	removeobject LOCALID_METEOR_FALLS_GOOD_GRUNT_2
	setflag FLAG_HIDE_ROUTE_112_TEAM_GRUNTS
	setvar VAR_METEOR_FALLS_STATE, 1
	releaseall
	end

